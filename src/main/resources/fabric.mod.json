{
	"schemaVersion": 1,
	"id": "bzgraph",
	"version": "${version}",
	"name": "BZgraph",
	"description": "In-game Hypixel SkyBlock bazaar price-history graphs. Data: SkyCofl (sky.coflnet.com).",
	"authors": [
		"tobi"
	],
	"contact": {
		"homepage": "https://sky.coflnet.com"
	},
	"license": "CC0-1.0",
	"icon": "assets/bzgraph/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.bzgraph.BzGraphClient"
		]
	},
	"mixins": [
		"bzgraph.mixins.json"
	],
	"custom": {
		"bzgraph:patch_index_url": "${patch_index_url}"
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
